{
  "name": "convert",
  "productName": "Convert",
  "version": "0.1.0",
  "description": "Offline drag-and-drop file converter for the desktop",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp",
      "ffmpeg-static",
      "ffprobe-static"
    ]
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.71",
    "@napi-rs/canvas": "^1.1.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "docx": "^9.15.4",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "node-html-parser": "^9.0.7",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tar-stream": "^3.2.2",
    "turndown": "^7.2.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "^3.1.5",
    "@types/turndown": "^5.0.6",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "author": "Convert"
}
